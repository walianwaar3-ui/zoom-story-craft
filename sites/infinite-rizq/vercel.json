{
  "cleanUrls": true,
  "trailingSlash": false,
  "rewrites": [
    {
      "source": "/universities",
      "destination": "/invite"
    },
    {
      "source": "/speak",
      "destination": "/invite"
    },
    {
      "source": "/student-ticket",
      "destination": "/seats"
    },
    {
      "source": "/venue",
      "destination": "/info"
    },
    {
      "source": "/agenda",
      "destination": "/info"
    }
  ],
  "headers": [
    {
      "source": "/dashboard",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-store"
        }
      ]
    }
  ]
}
