# Copy to .env.local for local development, or add these in Vercel →
# Project → Settings → Environment Variables. Leave both empty to keep data
# in the browser only.

# Supabase → Project Settings → API → Project URL
NEXT_PUBLIC_SUPABASE_URL=
# Supabase → Project Settings → API → "anon" / publishable key (safe for the browser)
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# NEVER put the service_role key here or anywhere in this app. It belongs only
# on the Hermes server.
